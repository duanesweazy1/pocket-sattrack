PKG_MAINTAINER="Duane Sweazy <duanesweazy1@users.noreply.github.com>"
PKG_HOMEPAGE=https://github.com/duanesweazy1/pocket-sattrack
APP_NAME="Sat Tracker"
APP_EXEC=/usr/share/APPLaunch/bin/pocket-sattrack
APP_TERMINAL=false
APP_ICON=share/images/pocket-sattrack.png
